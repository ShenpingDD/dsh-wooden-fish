{
  "name": "dsh-wooden-fish",
  "version": "2.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShenpingDD/dsh-wooden-fish.git"
  },
  "homepage": "https://github.com/ShenpingDD/dsh-wooden-fish#readme",
  "bugs": {
    "url": "https://github.com/ShenpingDD/dsh-wooden-fish/issues"
  },
  "description": "🪵 电子木鱼桌宠 — A clickable wooden-fish desktop pet for the DeepSeek Harness web GUI. Click to knock, counts per day, trends in settings.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js && node scripts/smoke.mjs"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "plugin",
    "wooden-fish",
    "desktop-pet",
    "muyu",
    "mindfulness"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  }
}
